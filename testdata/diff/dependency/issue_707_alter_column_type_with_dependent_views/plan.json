          "operation": "create",
          "path": "public.order_notes"
        },
        {
          "sql": "CREATE OR REPLACE VIEW order_totals AS\n SELECT sum(total) AS total\n   FROM orders;",
          "type": "view",
          "operation": "create",
          "path": "public.order_totals"
        },
        {
          "sql": "COMMENT ON VIEW order_totals IS 'sum of all orders';",
          "type": "view.comment",
          "operation": "create",
          "path": "public.order_totals"
        },
        {
          "sql": "CREATE MATERIALIZED VIEW IF NOT EXISTS order_totals_mv AS\n SELECT sum(total) AS total\n   FROM orders;",
          "type": "materialized_view",
          "operation": "create",
          "path": "public.order_totals_mv"
        },
        {
          "sql": "CREATE OR REPLACE VIEW order_notes_upper AS\n SELECT id,\n    upper(note::text) AS note\n   FROM order_notes;",
