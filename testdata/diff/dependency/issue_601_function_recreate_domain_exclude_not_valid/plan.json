        {
          "sql": "DROP FUNCTION IF EXISTS normalize_code(text);",
          "type": "function",
          "operation": "alter",
          "path": "public.normalize_code"
        },
        {
          "sql": "CREATE OR REPLACE FUNCTION normalize_code(\n    input text\n)\nRETURNS text\nLANGUAGE sql\nIMMUTABLE\nAS $$ SELECT lower(input)\n$$;",
          "type": "function",
          "operation": "alter",
          "path": "public.normalize_code"
        },
        {
          "sql": "ALTER DOMAIN quantity SET DEFAULT default_qty();",
          "type": "domain",
          "operation": "alter",
          "path": "public.quantity"
        },
        {
          "sql": "ALTER DOMAIN quantity ADD CONSTRAINT quantity_max CHECK (VALUE <= max_qty());",
          "type": "domain",
          "operation": "alter",
          "path": "public.quantity"
