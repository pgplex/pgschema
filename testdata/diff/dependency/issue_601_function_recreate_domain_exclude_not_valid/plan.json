        {
          "sql": "DROP FUNCTION IF EXISTS default_qty();",
          "type": "function",
          "operation": "alter",
          "path": "public.default_qty"
        },
        {
          "sql": "CREATE OR REPLACE FUNCTION default_qty()\nRETURNS bigint\nLANGUAGE sql\nIMMUTABLE\nAS $$ SELECT 5\n$$;",
          "type": "function",
          "operation": "alter",
          "path": "public.default_qty"
        },
        {
          "sql": "DROP FUNCTION IF EXISTS max_qty();",
          "type": "function",
          "operation": "alter",
          "path": "public.max_qty"
        },
        {
          "sql": "CREATE OR REPLACE FUNCTION max_qty()\nRETURNS bigint\nLANGUAGE sql\nIMMUTABLE\nAS $$ SELECT 100\n$$;",
          "type": "function",
          "operation": "alter",
          "path": "public.max_qty"
